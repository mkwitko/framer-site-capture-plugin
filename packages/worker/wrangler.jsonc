{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sitepromo-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "browser": { "binding": "BROWSER" },
  // Rate limiting binding: 5 captures per minute per key (ip or session).
  "ratelimits": [{ "name": "CAPTURE_RL", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  // KV for daily browser-time budget. Create with: wrangler kv namespace create QUOTA (owner action).
  // "kv_namespaces": [{ "binding": "QUOTA", "id": "<fill after creation>" }],
  "vars": { "CAPTURE_ENABLED": "1", "DAILY_BROWSER_BUDGET_MS": "480000" },
  "observability": { "enabled": true }
  // Secrets (wrangler secret put): SESSION_SECRET
}
